# IndieTracks 环境变量配置
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=indietracks
DB_USER=postgres
DB_PASS=postgres

# ============================================
# MinIO 配置
# ============================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=indietracks
MINIO_ENDPOINT=http://localhost:9000

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# ============================================
# 后端配置
# ============================================
SERVER_PORT=8080
